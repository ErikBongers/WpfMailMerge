<Window x:Class="WpfMailMerge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfMailMerge"
        mc:Ignorable="d"
        Title="Mail Merge" 
        SizeToContent = "WidthAndHeight"
        Width="700" Height="Auto"
        MinWidth="700" MinHeight="382"
        MaxWidth = "{Binding SystemParameters.MaximizedPrimaryScreenWidth}"
        MaxHeight = "{Binding SystemParameters.MaximizedPrimaryScreenHeight}"
        Closing="Window_Closing">
    <Window.DataContext>
        <local:MailMerge/>
    </Window.DataContext>
    <StackPanel Orientation="Vertical" Margin="10,10,10,20">
        <GroupBox Header="Gegevens">
            <StackPanel Orientation="Vertical" Margin="10">
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblWordTemplate" Width="100" Content="Word template:" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Right"/>
                    <TextBox x:Name="txtWordTemplate" VerticalAlignment="Center"
                     Text="{Binding Path=WordTemplateFileName}"/>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblDataSource" Width="100" Content="Excel lijst:" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Right"/>
                    <TextBox x:Name="txtDataSource" VerticalAlignment="Center"
                     Text="{Binding Path=DataSourceFileName}"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="E-mail">
            <StackPanel Orientation="Vertical" Margin="10">
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblSender" Content="Afzender:" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" HorizontalContentAlignment="Right"
                       Visibility="{Binding SenderComboVisibilityx}"/>
                    <ComboBox x:Name="cmbSenderAccount" VerticalAlignment="Center"
                              ItemsSource="{Binding Path=MailAccounts}"
                              SelectedValue="{Binding Path=MailAccountIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Index"
                              DisplayMemberPath="DisplayName"
                              Visibility="{Binding SenderComboVisibilityx}"
                              />
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblOnBehalfOf" Content="In naam van:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Right"/>
                    <TextBox x:Name="txtOnBehalfOf" VerticalAlignment="Center"
                         Text="{Binding Path=OnBehalfOfEmail, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label Content="Ontvanger:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Right"/>
                    <CheckBox x:Name="chkUseTestRecipient" Content="Gebruik test email" VerticalAlignment="Center"
                              IsChecked="{Binding Path=UseTestRecipient, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label Content="Test e-mail:" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Right"
                           Visibility="{Binding Path=TestEmailVisibility}"/>
                    <TextBox x:Name="txtRecipient" VerticalAlignment="Top"
                         Text="{Binding Path=TestRecipient}"
                         Visibility="{Binding Path=TestEmailVisibility}"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <DockPanel LastChildFill="True" Margin="0,20,0,0">
            <Button x:Name="btnStart" Content="Start" VerticalAlignment="Top" Click="btnStart_Click" Width="100"/>
        </DockPanel>
        <DockPanel LastChildFill="True">
            <Label x:Name="lblStatusMessage" Height="29" VerticalAlignment="Top" Margin="50,0,50,0"
               Content="{Binding Path=StatusMessage, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>
        <Grid Margin="50,0,50,0">
            <ProgressBar x:Name="progressBar" Height="20"
                         Maximum="{Binding Path=ProgressMaxValue, UpdateSourceTrigger=PropertyChanged}"
                         Value="{Binding Path=ProgressValue, UpdateSourceTrigger=PropertyChanged}"
                         />
            <Label x:Name="lblProgress"
               Content="{Binding Path=ProgressInfo, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
    </StackPanel>
</Window>
