<Window x:Class="WpfMailMerge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfMailMerge"
        mc:Ignorable="d"
        Title="MainWindow" Height="297" Width="800">
    <Window.DataContext>
        <local:MailMerge/>
    </Window.DataContext>
    <Grid>
        <Button x:Name="btnStart" Content="Start" HorizontalAlignment="Left" Margin="293,227,0,0" VerticalAlignment="Top" Click="btnStart_Click" Padding="7,3,7,3"/>
        <Label x:Name="lblStatusMessage" HorizontalAlignment="Left" Height="29" Margin="158,141,0,0" VerticalAlignment="Top" Width="508"
               Content="{Binding Path=StatusMessage, UpdateSourceTrigger=PropertyChanged}"/>
        <ProgressBar x:Name="progressBar" HorizontalAlignment="Left" Height="20" Margin="158,186,0,0" VerticalAlignment="Top" Width="508"
                     Maximum="{Binding Path=ProgressMaxValue, UpdateSourceTrigger=PropertyChanged}"
                     Value="{Binding Path=ProgressValue, UpdateSourceTrigger=PropertyChanged}"
                     />
        <Label x:Name="lblProgress" HorizontalAlignment="Left" Height="36" Margin="158,182,0,0" VerticalAlignment="Top" Width="508"
               Content="{Binding Path=ProgressInfo, UpdateSourceTrigger=PropertyChanged}"/>
        <ComboBox x:Name="cmbSenderAccount" HorizontalAlignment="Left" Height="31" Margin="158,21,0,0" VerticalAlignment="Top" Width="508"
                  ItemsSource="{Binding Path=MailAccounts}"
                  SelectedValue="{Binding Path=MailAccountIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectedValuePath="Index"
                  DisplayMemberPath="DisplayName"
                  />
        <Label x:Name="lblSender" Content="Afzender:" HorizontalAlignment="Left" Height="26" Margin="41,26,0,0" VerticalAlignment="Top" Width="112" HorizontalContentAlignment="Right"/>
        <Label Content="Ontvanger:" HorizontalAlignment="Left" Height="25" Margin="75,68,0,0" VerticalAlignment="Top" Width="78" HorizontalContentAlignment="Right"/>
        <CheckBox x:Name="chkUseTestRecipient" Content="Gebruik test email" HorizontalAlignment="Left" Height="25" Margin="170,74,0,0" VerticalAlignment="Top" Width="320"
                  IsChecked="{Binding Path=UseTestRecipient, Mode=TwoWay}"/>
        <TextBox x:Name="txtRecipient" HorizontalAlignment="Left" Height="32" Margin="158,104,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="508"
                 Text="{Binding Path=TestRecipient}"
                 Visibility="{Binding Path=TestEmailVisibility}"/>

    </Grid>
</Window>
