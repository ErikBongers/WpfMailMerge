<Window x:Class="WpfMailMerge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfMailMerge"
        xmlns:cnv="clr-namespace:XamlConverters"
        mc:Ignorable="d"
        Title="Mail Merge" 
        SizeToContent = "WidthAndHeight"
        Width="700" Height="Auto"
        MinWidth="700" MinHeight="382"
        MaxWidth = "{Binding SystemParameters.MaximizedPrimaryScreenWidth}"
        MaxHeight = "{Binding SystemParameters.MaximizedPrimaryScreenHeight}"
        Closing="Window_Closing" d:DesignHeight="481.73"
        Background="AliceBlue"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <local:MailMergeViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <cnv:BoolToColorBrushConverter x:Key="ColorConverter"></cnv:BoolToColorBrushConverter>
        <Style x:Key="RedBalloon" TargetType="Border">
            <Setter Property="BorderBrush" Value="Salmon"/>
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="Salmon"/>
        </Style>
    </Window.Resources>
    <StackPanel Orientation="Vertical" Margin="10,10,10,20">
        <GroupBox Header="{StaticResource Data}" Background="White">
            <StackPanel Orientation="Vertical" Margin="10">
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblWordTemplate" Width="100" Content="{StaticResource Word template}" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Right"/>
                    <TextBox x:Name="txtWordTemplate" VerticalAlignment="Center"
                     Text="{Binding Path=WordTemplateFileName}"/>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblDataSource" Width="100" Content="{StaticResource Excel workbook}" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Right"/>
                    <TextBox x:Name="txtDataSource" VerticalAlignment="Center"
                     Text="{Binding Path=DataSourceFileName}"/>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblNamedRanges" Content="Data:" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" HorizontalContentAlignment="Right"
                       Visibility="{Binding NamedRangesComboVisibility}"/>
                    <ComboBox x:Name="cmbSenderAccount" VerticalAlignment="Center"
                              ItemsSource="{Binding Path=NamedRanges}"
                              SelectedValue="{Binding Path=SelectedNamedRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="DisplayName"
                              DisplayMemberPath="DisplayName"
                              Visibility="{Binding NamedRangesComboVisibility}"
                              />
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label Content="{StaticResource Extra Data:}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Right"/>
                    <CheckBox x:Name="chkMergeOtherExcels" Content="{StaticResource Merge other Excel files in this directory}" VerticalAlignment="Center"
                              IsChecked="{Binding Path=MergeOtherExcels, Mode=TwoWay}"/>
                </DockPanel>

            </StackPanel>
        </GroupBox>
        <GroupBox Header="{StaticResource Email}" Background="White">
            <StackPanel Orientation="Vertical" Margin="10">
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblSender" Content="{StaticResource Sender:}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="100" HorizontalContentAlignment="Right"
                       Visibility="{Binding SenderComboVisibility}"/>
                    <ComboBox x:Name="cmbNamedRange" VerticalAlignment="Center"
                              ItemsSource="{Binding Path=MailAccounts.Result}"
                              SelectedValue="{Binding Path=MailAccountIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Index"
                              DisplayMemberPath="DisplayName"
                              Visibility="{Binding SenderComboVisibility}"
                              />
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label x:Name="lblOnBehalfOf" Content="{StaticResource On behalf of:}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Right"/>
                    <TextBox x:Name="txtOnBehalfOf" VerticalAlignment="Center"
                         Text="{Binding Path=OnBehalfOfEmail, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label Content="{StaticResource Recipient:}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Right"/>
                    <CheckBox x:Name="chkUseTestRecipient" Content="{StaticResource Use test address}" VerticalAlignment="Center"
                              IsChecked="{Binding Path=UseTestRecipient, Mode=TwoWay}"/>
                </DockPanel>
                <DockPanel LastChildFill="True">
                    <Label Content="{StaticResource Test email:}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" HorizontalContentAlignment="Right"
                           Visibility="{Binding Path=TestEmailVisibility}"/>
                    <TextBox x:Name="txtRecipient" VerticalAlignment="Center"
                         Text="{Binding Path=TestRecipient}"
                         Visibility="{Binding Path=TestEmailVisibility}"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="{StaticResource Start info}" Background="White">
            <StackPanel Orientation="Vertical" Margin="10">
                <DockPanel LastChildFill="False">
                    <Label x:Name="lblStartIndex" Width="100" Content="{StaticResource Start at index:}" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Right"/>
                    <TextBox x:Name="txtStartIndex" VerticalAlignment="Center" Width="40"
                        Text="{Binding Path=RequestedStartIndex}"/>
                    <Border Style="{StaticResource RedBalloon}" Margin="15,0,0,0" Visibility="{Binding Path=ShowRecoveredStartIndexMessage}">
                        <Label x:Name="lblRecovery" Content="&lt;-- Recovered last position." HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Left"
                               Background="Transparent"
                               Padding="10, 0"/>
                    </Border>
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <DockPanel LastChildFill="True" Margin="0,20,0,0">
            <Button x:Name="btnStartStop" VerticalAlignment="Top" Click="btnStartStop_Click" Width="100"
                    Content="{Binding Path=StartStopText}"
                    IsEnabled="{Binding Path=CanStart}"/>
        </DockPanel>
        <DockPanel LastChildFill="True">
            <Label x:Name="lblStatusMessage" Height="auto" VerticalAlignment="Top" Margin="50,0,50,0"
                Content="{Binding Path=StatusMessage, UpdateSourceTrigger=PropertyChanged}"
                Background="{Binding Path=InError, Converter={StaticResource ColorConverter}, ConverterParameter=Red;Transparent;0.2, Mode=OneWay}"/>
        </DockPanel>
        <Grid Margin="50,0,50,0">
            <ProgressBar x:Name="progressBar" Height="20"
                         Maximum="{Binding Path=ProgressMaxValue, UpdateSourceTrigger=PropertyChanged}"
                         Value="{Binding Path=ProgressValue, UpdateSourceTrigger=PropertyChanged}"
                         />
            <Label x:Name="lblProgress"
               Content="{Binding Path=ProgressInfo, UpdateSourceTrigger=PropertyChanged}"
                   />
        </Grid>
    </StackPanel>
</Window>
